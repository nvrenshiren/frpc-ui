{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "frpc-ui",
  "version": "../package.json",
  "identifier": "com.dawi.frpc-ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "frpc-ui · 连接工作台",
        "width": 1360,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0B1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] } }
  }
}
